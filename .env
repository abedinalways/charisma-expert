# ════════════════════════════════
# DJANGO
# ════════════════════════════════
DJANGO_SECRET_KEY=django-insecure-test-key-local-development-charisma-expert-backend-001
DEBUG=True
DJANGO_SETTINGS_MODULE=core.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:5173
GOOGLE_OAUTH_CLIENT_ID=

# Step 1: keep True to run on SQLite with zero infra.
USE_SQLITE=True

# ════════════════════════════════
# DATABASE — PostgreSQL (Step 2)
# ════════════════════════════════
DB_NAME=law_enforcement_db
DB_USER=le_user
DB_PASSWORD=your_strong_password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60

# ════════════════════════════════
# REDIS (Phase 5)
# ════════════════════════════════
REDIS_URL=redis://localhost:6379/0

# ════════════════════════════════
# AWS (Phase 3)
# ════════════════════════════════
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_BUCKET_REGION=us-east-1

# ════════════════════════════════
# AI MODEL (Phase 3)
# ════════════════════════════════
AI_MODE=mock
USE_LOCAL_MODEL=True
LOCAL_MODEL_URL=http://localhost:11434
LOCAL_MODEL_NAME=llama3.2
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_REQUEST_TIMEOUT=300
BEDROCK_MODEL_ID=
BEDROCK_REGION=us-east-1

# ════════════════════════════════
# EMAIL — SMTP (Phase 2: verification + password reset)
# ════════════════════════════════
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=Klyvorek <noreply@example.com>

# ════════════════════════════════
# STRIPE (Phase 4)
# ════════════════════════════════
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
